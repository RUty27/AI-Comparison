# Copy to .env.local and adjust if needed.

# Set to 1 to use fake streaming replies (no CLIs needed). Handy for trying the UI.
DUOBOT_MOCK=0

# Paths to the CLIs if they are not on your PATH.
CLAUDE_BIN=claude
GEMINI_BIN=gemini

# Optional model overrides (leave empty for each CLI's default).
CLAUDE_MODEL=
GEMINI_MODEL=

# Kill a CLI call after this many milliseconds.
CLI_TIMEOUT_MS=300000
